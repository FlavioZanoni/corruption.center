POSTGRES_USER=corruption
POSTGRES_PASSWORD=corruption
POSTGRES_DB=corruption
DATABASE_URL=postgres://corruption:corruption@postgres:5432/corruption
# Host port for Postgres (change if 5432 is taken on your machine)
POSTGRES_HOST_PORT=5432

MEMGRAPH_URI=bolt://memgraph:7687
# Dev Memgraph runs auth-less: leave empty
MEMGRAPH_USER=
MEMGRAPH_PASS=

PORT=8080
DEV=true

BACKOFFICE_USER=admin
BACKOFFICE_PASS=changeme

# Baseline scandals (Lava Jato, Calicute, Mensalão) are seeded on every API
# start and their cases registered with the watchers. Set to false to skip.
SEED_BASELINE=true

# Frontend: leave NEXT_PUBLIC_API_URL empty to use mock data
FRONTEND_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:8080

# Public origin of the site. Used for canonical URLs, Open Graph tags, robots.txt
# and the sitemap, so it must be the real https origin in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-side API base, used by server components and the sitemap generator.
# NEXT_PUBLIC_API_URL is browser-facing, so inside Docker it points at the host
# and is unreachable from the frontend container: this goes through the compose
# service name instead. Falls back to NEXT_PUBLIC_API_URL when unset.
API_URL=http://api:8080

# CNJ DataJud public key rotates; the current one is published at
# https://datajud-wiki.cnj.jus.br/api-publica/acesso/
DATAJUD_API_KEY=your_datajud_key_here

# CGU Portal da Transparência: free self-service signup:
# https://api.portaldatransparencia.gov.br/api-de-dados/cadastrar-email
TRANSPARENCIA_API_KEY=your_transparencia_key_here

# CNPJ enrichment provider (self-host minha receita to lift rate limits)
CNPJ_API_BASE=https://minhareceita.org
CNPJ_RATE_PER_MIN=30

# Browser origins allowed to call the API (comma-separated). Unset, the API
# allows localhost:3000 only, so this MUST be set once the site is served from
# a real domain -- otherwise the browser blocks every request and the graph
# renders empty with no server-side error to show for it.
# CORS_ALLOWED_ORIGINS=https://corruption.center

# DataJud: cases polled per run (0 = all that need it). Lower it to sample.
DATAJUD_POLL_LIMIT=0
