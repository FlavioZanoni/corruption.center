FROM node:22-alpine

WORKDIR /app

# Enable pnpm (pinned: pnpm@latest broke the build when v11 changed the
# build-script approval settings — bump deliberately)
RUN corepack enable && corepack prepare pnpm@11.11.0 --activate

# Install dependencies (pnpm-workspace.yaml carries onlyBuiltDependencies —
# without it pnpm 10 refuses to run sharp's native build script)
COPY package.json pnpm-lock.yaml* pnpm-workspace.yaml* ./
RUN pnpm install

# Copy source
COPY . .

# Expose port
EXPOSE 3000
ENV PORT=3000
ENV HOSTNAME="0.0.0.0"

# Run in dev mode with HMR
CMD ["pnpm", "dev"]