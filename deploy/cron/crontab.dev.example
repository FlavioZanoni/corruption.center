# corruption.center worker cron examples (dev compose)
# Edit absolute paths before installing:
#   crontab deploy/cron/crontab.dev.example

SHELL=/bin/bash
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

# Weekly Camara sync: Mondays 03:05 UTC
5 3 * * 1 /home/flaggzz/repos/corruption.center/deploy/cron/run-compose-worker.sh /home/flaggzz/repos/corruption.center/docker-compose.dev.yml camara-sync

# Weekly Senado sync: Mondays 03:20 UTC
20 3 * * 1 /home/flaggzz/repos/corruption.center/deploy/cron/run-compose-worker.sh /home/flaggzz/repos/corruption.center/docker-compose.dev.yml senado-sync

# DataJud watcher daily: every day 02:10 UTC
10 2 * * * /home/flaggzz/repos/corruption.center/deploy/cron/run-compose-worker.sh /home/flaggzz/repos/corruption.center/docker-compose.dev.yml datajud-watcher

# DJEN party discovery daily: every day 03:40 UTC (after the DataJud watcher)
40 3 * * * /home/flaggzz/repos/corruption.center/deploy/cron/run-compose-worker.sh /home/flaggzz/repos/corruption.center/docker-compose.dev.yml djen-sync

# Sanctions sync (CGU + TCU) weekly: Tuesdays 04:05 UTC
5 4 * * 2 /home/flaggzz/repos/corruption.center/deploy/cron/run-compose-worker.sh /home/flaggzz/repos/corruption.center/docker-compose.dev.yml sanctions-sync

# CNPJ enricher weekly: Wednesdays 04:05 UTC (enriches orgs discovered during the week)
5 4 * * 3 /home/flaggzz/repos/corruption.center/deploy/cron/run-compose-worker.sh /home/flaggzz/repos/corruption.center/docker-compose.dev.yml cnpj-enricher

# Photos enricher monthly: 1st of the month 05:05 UTC (photos change rarely)
5 5 1 * * /home/flaggzz/repos/corruption.center/deploy/cron/run-compose-worker.sh /home/flaggzz/repos/corruption.center/docker-compose.dev.yml photos-enricher
