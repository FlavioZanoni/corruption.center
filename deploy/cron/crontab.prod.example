# corruption.center worker cron examples (prod compose)
# Edit absolute paths and ensure .env has required vars before installing:
#   crontab deploy/cron/crontab.prod.example

SHELL=/bin/bash
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

# Weekly Camara sync: Mondays 03:05 UTC
5 3 * * 1 /home/flaggzz/repos/corruption.center/deploy/cron/run-compose-worker.sh /home/flaggzz/repos/corruption.center/docker-compose.yml camara-sync

# Weekly Senado sync: Mondays 03:20 UTC
20 3 * * 1 /home/flaggzz/repos/corruption.center/deploy/cron/run-compose-worker.sh /home/flaggzz/repos/corruption.center/docker-compose.yml senado-sync

# DataJud watcher daily: every day 02:10 UTC
10 2 * * * /home/flaggzz/repos/corruption.center/deploy/cron/run-compose-worker.sh /home/flaggzz/repos/corruption.center/docker-compose.yml datajud-watcher
